{
  "name": "jobscan-backend",
  "version": "2.1.0",
  "description": "JobScan API – Node.js / Express rewrite",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "mongo": "node scripts/startMongo.js",
    "dev:all": "concurrently --kill-others-on-fail --names \"MongoDB,Backend\" --prefix-colors \"green,blue\" \"npm run mongo\" \"nodemon src/server.js\"",
    "lint": "eslint src/**/*.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "compromise": "^14.13.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.32.0",
    "pdf-parse": "^1.1.4",
    "puppeteer": "^22.10.0",
    "yahoo-finance2": "^2.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
