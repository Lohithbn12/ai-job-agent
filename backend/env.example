# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/jobscan
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/jobscan?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/jobscan

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_long_random_secret_at_least_32_chars
JWT_EXPIRE=720h   # 30 days

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── Puppeteer ─────────────────────────────────────────────────────────────────
# Set to "true" to show browser window during scraping (debugging only)
PUPPETEER_HEADLESS=true

# ── LinkedIn auto-apply (optional) ───────────────────────────────────────────
# Only needed if you use the /auto-apply endpoint
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
